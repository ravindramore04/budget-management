		<form-property name="txtAmount" type="java.lang.String"/>
		<form-property name="txtRemark" type="java.lang.String"/>
		<form-property name="strDepartmentId" type="strDepartmentId"/>		
	</form-bean>
	
	
	
	<form-bean name="ChngPswd" type="org.apache.struts.validator.DynaValidatorForm">
		<form-property name="txtOldPassword" type="java.lang.String"/>
		<form-property name="txtPassword" type="java.lang.String"/>
