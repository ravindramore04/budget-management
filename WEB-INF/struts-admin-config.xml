			 <forward name="failure" path="/jsp/error.jsp"/>
		</action>
		

		<action path="/SaveHead" type="struts.adminpanel.SaveHeadHandler" name="HeadForm" scope="request" validate="false">
                         <forward name="success" path="/AllHead.do"/>
			 <forward name="failure" path="/jsp/error.jsp"/>
		</action>
		
		<action path="/AllGroup" type="struts.adminpanel.AllGroupHamdler" name="HeadForm" scope="request" validate="false">
