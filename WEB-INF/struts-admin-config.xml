		</action>
		<action path="/OpenNewYear" type="struts.adminpanel.OpenNewYearHandler" name="ListForm" scope="request" validate="false">
			 <forward name="success" path="/jsp/adminpanel/newyear.jsp"/>
			 <forward name="failure" path="/jsp/error.jsp"/>
		</action>
		<action path="/SaveFinanceYear" type="struts.adminpanel.SaveNewYearHandler" name="FinanceForm" scope="request" validate="false">
			 <forward name="success" path="/NewFinanceYear.do"/>
