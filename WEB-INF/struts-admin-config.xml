		<form-property name="txtDBName" type="java.lang.String"/>
	</form-bean>



</form-beans>

	<!-- ========== Global Forward Definitions ============================== -->
	<global-forwards>
		<forward name="failure" path="/jsp/error.jsp"/>
	</global-forwards>
	<!-- ========== Action Mapping Definitions ============================== -->

	<action-mappings>
		<!-- Begin -->
		<action path="/AllUser" type="struts.adminpanel.AllUserHandler" name="ListForm" scope="request" validate="false">
                         <forward name="success" path="/jsp/adminpanel/alluser.jsp"/>
			 <forward name="failure" path="/jsp/error.jsp"/>
		</action>
		
		<action path="/OpenUser" type="struts.adminpanel.OpenUserHandler" name="ListForm" scope="request" validate="false">
                         <forward name="success" path="/jsp/adminpanel/user.jsp"/>
			 <forward name="failure" path="/jsp/error.jsp"/>
		</action>
		
		<action path="/AddUser" type="struts.adminpanel.SaveUserHandler" name="UserForm" scope="request" validate="false">
                         <forward name="success" path="/AllUser.do"/>
			 <forward name="failure" path="/jsp/error.jsp"/>
		</action>
		
		<action path="/Organisation" type="struts.adminpanel.NewOrganisation" scope="request" validate="false">
                         <forward name="success" path="/jsp/adminpanel/Organisation.jsp"/>
			 <forward name="failure" path="/jsp/error.jsp"/>
		</action>
		
		<action path="/OrganisationPage" type="struts.adminpanel.OrganisationHandler" name="OrganiForm" scope="request" validate="false">
                        <forward name="success" path="/ValidatedLogin.do"/>
